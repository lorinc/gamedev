{
  "format": "spelunking-ruleset",
  "version": 1,
  "name": "b1.5",
  "note": "b1.3 + the backpack (D038): 6 slots of 16, every material mined goes in, building costs 1 rock per tile (soft before hard), no room for rock drops it, no room for ore or loot refuses (packFull). b1.3 was: b1.2 + clinging above a chasm (D035): ↗ ↖ toward the wall you hold climb up it (stairUp), ↘ ↙ mine into rock while clinging, any mining is allowed, and gravity: nothing holds you → you fall; deeper than harmlessDrop → home.",
  "swipes": { "swipePx": 24, "horizontalDeg": 30, "verticalDeg": 25 },
  "situations": {
    "always": [],
    "onFloor": ["standing"],
    "noFooting": ["!standing"],
    "walkable": ["fwdOpen", "fwdFloor"],
    "stepDownAhead": ["standing", "fwdOpen", "fwdBelowOpen", "fwdBelowFloor"],
    "gapInReach": ["standing", "fwdOpen", "fwdDrop"],
    "gap": ["fwdOpen"],
    "stepUpAhead": ["standing", "!fwdOpen", "fwdAboveOpen", "aboveOpen"],
    "rockAhead": ["!fwdOpen"],
    "ledgeAhead": ["standing", "fwdOpen", "fwdBelowOpen", "!fwdBelowFloor"],
    "wallBelow": ["belowClimbable"],
    "overhang": ["overhangStep"],
    "dropBelow": ["belowDrop"],
    "rockDownAhead": ["!fwdBelowOpen"],
    "wallAhead": ["!standing", "!fwdOpen"]
  },
  "table": {
    "side": [
      { "if": "walkable", "do": "walk" },
      { "if": "stepDownAhead", "do": "stepDown" },
      { "if": "gapInReach", "do": "dropOff" },
      { "if": "gap", "do": "refuse", "reason": "ledge" },
      { "if": "stepUpAhead", "do": "stepUp" },
      { "if": "rockAhead", "do": "tunnel" }
    ],
    "down": [
      { "if": "ledgeAhead", "do": "climbOver" },
      { "if": "onFloor", "do": "refuse", "reason": "down" },
      { "if": "wallBelow", "do": "climbDown" },
      { "if": "overhang", "do": "followOverhang" },
      { "if": "dropBelow", "do": "climbDrop" },
      { "if": "always", "do": "refuse", "reason": "overhang" }
    ],
    "up": [{ "if": "always", "do": "refuse", "reason": "up" }],
    "upSide": [
      { "if": "wallAhead", "do": "stairUp", "place": "built" },
      { "if": "noFooting", "do": "refuse", "reason": "noFooting" },
      { "if": "onFloor", "do": "stairUp", "place": "built" }
    ],
    "downSide": [
      { "if": "rockDownAhead", "do": "mineDown" },
      { "if": "noFooting", "do": "refuse", "reason": "noFooting" },
      { "if": "onFloor", "do": "buildDown", "place": "built" }
    ]
  },
  "reasons": {
    "ledge": "none",
    "down": "none",
    "overhang": "none",
    "up": "none",
    "noFooting": "none",
    "bedrock": "none",
    "noRule": "none",
    "noRock": "flash",
    "packFull": "flash"
  },
  "stops": { "wall": true, "open": true, "loot": true, "harder": true, "junction": true },
  "numbers": {
    "walkTicks": 7,
    "climbTicks": 10,
    "fallTicks": 3,
    "buildTicks": 14,
    "digTicks": { "soft": 14, "hard": 42, "ore": 21, "loot": 14, "built": 7 },
    "harmlessDrop": 4,
    "packSlots": 6,
    "gravity": true
  }
}
