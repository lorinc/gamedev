{
  // Type-checks the plain .js sources from their JSDoc comments. Emits nothing: the browser
  // runs the files as they are. lib ES2020 = the oldest browsers we target (iOS 14 Safari),
  // so newer APIs are flagged. Tests and tools/ run in Node and aren't checked: that would
  // need @types/node.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.js"]
}
