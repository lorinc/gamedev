#!/usr/bin/env bash
# Runs before every push. The repo is public and GitHub Pages serves main, so a push publishes:
# this is the only gate between a broken commit and the live site. ~5 s.
# Enable once per clone:  git config core.hooksPath .githooks
# Skip in an emergency:   git push --no-verify   (and say so in the next commit)
# Note: it checks the working tree, so commit or stash unrelated edits first.
set -euo pipefail
ROOT=$(git rev-parse --show-toplevel)

# A major release carries the build check's verdict (R16): a trailer line "Build-check: pass …" or
# "Build-check: skipped (why)", from the build-check sub-agent's report. Major = the commit adds a new
# bundle page (bN.html) or closes a prototype entry (status: concluded / killed). Point freezes
# (b1.N, every push) don't need one; the automated checks below run on every push anyway.
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = 0000000000000000000000000000000000000000 ] && continue # deleting a ref
  range=("$remote_sha..$local_sha")
  # a new ref, or a force-push over commits we never fetched: everything no remote has yet
  if [ "$remote_sha" = 0000000000000000000000000000000000000000 ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    range=("$local_sha" --not --remotes)
  fi
  for c in $(git rev-list "${range[@]}"); do
    major=$(git diff-tree --no-commit-id --name-only -r --diff-filter=A "$c" | grep -E '^[^/]+/b[0-9]+\.html$' || true)
    git diff-tree --no-commit-id -p "$c" -- '*/timeline/*/entry.md' | grep -qE '^\+status: (concluded|killed)' && major="closes an entry"
    [ -z "$major" ] && continue
    git log -1 --format=%B "$c" | grep -qE '^Build-check: (pass|skipped \(.+\))' && continue
    echo "pre-push · $(git log -1 --format='%h %s' "$c")"
    echo "  a major release ($major) without a 'Build-check:' line (R16): run the build-check agent, then amend or reword"
    exit 1
  done
done

for game in "$ROOT"/*/package.json; do
  dir=$(dirname "$game")
  name=$(basename "$dir")
  echo "pre-push · $name"
  cd "$dir"
  if [ ! -x node_modules/.bin/tsc ]; then echo "  $name: run npm install first (tsc is the type check)"; exit 1; fi
  npx --no-install tsc -p . || { echo "  $name: type check failed"; exit 1; }
  node --test --test-reporter=dot >/dev/null 2>&1 || { node --test 2>&1 | grep -E '^not ok|^# (pass|fail)'; echo "  $name: tests failed"; exit 1; }
  if [ -f tools/timeline.js ]; then
    # every page loads in a browser without errors (R15)
    [ -x tools/smoke.sh ] && { tools/smoke.sh >/dev/null || { tools/smoke.sh; echo "  $name: a page has errors in the browser"; exit 1; }; }
    node tools/timeline.js --strict >/dev/null || { echo "  $name: timeline has problems (npm run timeline)"; exit 1; }
    git diff --quiet -- timeline/index.html || { echo "  $name: timeline/index.html was stale; it's regenerated now, commit it"; exit 1; }
    # every playable version is on the timeline (D037): the pushed commit's b1 must be a frozen build
    if [ -x tools/unfrozen.sh ] && ! next=$(tools/unfrozen.sh); then
      echo "  $name: b1 changed since its newest frozen build; push with npm run ship (freezes $next)"; exit 1
    fi
  fi
done
echo "pre-push · ok"
